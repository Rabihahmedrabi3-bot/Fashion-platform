NODE_ENV=development
PORT=4000

# Run scripts/db/setup-local.sql once (see that file's header) to create
# the fashion_platform_app role and these two databases on your local
# Postgres instance, then fill in the password you chose below.
DATABASE_URL=postgresql://fashion_platform_app:changeme@localhost:5432/fashion_platform_dev
TEST_DATABASE_URL=postgresql://fashion_platform_app:changeme@localhost:5432/fashion_platform_test

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Refresh tokens are opaque random values, not JWTs, so there is no separate
# JWT_REFRESH_SECRET - only the access token is signed, and the refresh/
# verification/reset tokens are HMAC'd with the pepper below for storage.
JWT_ACCESS_SECRET=
# Separate from JWT_ACCESS_SECRET (staff/admin) so a customer session token
# can never be replayed against a staff/admin endpoint, or vice versa.
JWT_CUSTOMER_ACCESS_SECRET=
REFRESH_TOKEN_HASH_PEPPER=

# Used for subdomain-based tenant resolution on the public storefront
# (not exercised yet in Increment 1 - no storefront app exists).
APP_BASE_DOMAIN=platform.local

# Comma-separated list of origins allowed to call this API: Merchant Portal
# (5173), Storefront (3000), and Admin Portal (5174) all make client-side
# (browser) calls directly against this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# Where uploaded images (product photos, store logo, theme hero image) are
# stored - local disk isn't durable on Render's free tier (wiped on every
# redeploy/restart), so these are required even in local dev. Cloudflare R2
# is S3-compatible object storage: create a bucket, an API token (R2 ->
# "Manage R2 API Tokens"), and enable public access on the bucket (either a
# custom domain or the r2.dev public URL) for R2_PUBLIC_BASE_URL below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Local dev only: seeds one platform Super Admin user on first `npm run db:seed`.
BOOTSTRAP_ADMIN_EMAIL=admin@platform.local
BOOTSTRAP_ADMIN_PASSWORD=

# Shown in dev-console email output; no real provider is wired up yet
# (see src/lib/email.ts - DevConsoleEmailProvider).
EMAIL_FROM_ADDRESS=no-reply@platform.local
